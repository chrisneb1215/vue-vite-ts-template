{
    "name": "vite-vue-ts-template",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "postdev": "node server/server.ts",
        "prebuild": "vite optimize",
        "build": "vite build && vite build --ssr",
        "postbuild": "npm run pm2:restart",
        "preinstall": "npm run pm2:delete && npm run pm2:start",
        "pm2:start": "npx pm2 start dist/server/server.js --name vite-ssr",
        "pm2:restart": "npx pm2 restart vite-ssr",
        "pm2:stop": "npx pm2 stop vite-ssr",
        "pm2:delete": "npx pm2 delete vite-ssr",
        "pm2:list": "npx pm2 list",
        "preview": "vite preview"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "@fastify/middie": "^9.0.3",
        "@fastify/static": "^8.1.1",
        "@vueuse/head": "^2.0.0",
        "axios": "^1.7.9",
        "canvas": "^3.1.0",
        "dayjs": "^1.11.13",
        "element-plus": "^2.9.3",
        "fastify": "^5.2.1",
        "pinia": "^2.3.1",
        "vite-plugin-builder": "^1.0.0",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@iconify-json/ep": "^1.2.2",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vitejs/plugin-vue-jsx": "^4.1.1",
        "@vue/tsconfig": "^0.7.0",
        "pm2": "^5.4.3",
        "sass": "^1.83.4",
        "typescript": "~5.6.2",
        "unocss": "^65.4.3",
        "unplugin-auto-import": "^19.0.0",
        "unplugin-icons": "^22.0.0",
        "unplugin-vue-components": "^28.0.0",
        "vite": "^6.0.5",
        "vue-tsc": "^2.2.0"
    }
}
