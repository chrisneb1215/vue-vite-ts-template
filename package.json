{
    "name": "vite-vue-ts-template",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "postdev": "node ./server/server.ts",
        "prebuild": "rm -rf dist",
        "build": "npm run build:csr && npm run build:ssr",
        "build:csr": "vite build",
        "build:ssr": "vite build --ssr",
        "postbuild": "pm2 restart social-ssr || pm2 start pm2.json",
        "start": "pm2 restart social-ssr || pm2 start pm2.json",
        "stop": "pm2 stop social-ssr",
        "logs": "pm2 logs social-ssr",
        "preview": "vite preview"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "@fastify/middie": "^9.0.3",
        "@fastify/static": "^8.1.1",
        "@vueuse/head": "^2.0.0",
        "axios": "^1.7.9",
        "canvas": "^3.1.0",
        "dayjs": "^1.11.13",
        "element-plus": "^2.9.3",
        "fastify": "^5.2.1",
        "pinia": "^2.3.1",
        "vite-plugin-builder": "^1.0.0",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@iconify-json/ep": "^1.2.2",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vitejs/plugin-vue-jsx": "^4.1.1",
        "@vue/tsconfig": "^0.7.0",
        "pm2": "^5.4.3",
        "sass": "^1.83.4",
        "typescript": "~5.6.2",
        "unocss": "^65.4.3",
        "unplugin-auto-import": "^19.0.0",
        "unplugin-icons": "^22.0.0",
        "unplugin-vue-components": "^28.0.0",
        "vite": "^6.0.5",
        "vue-tsc": "^2.2.0"
    }
}
